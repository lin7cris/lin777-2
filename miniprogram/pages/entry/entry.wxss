.entry-heading {
  padding: 18rpx 4rpx 4rpx;
}

.eyebrow,
.section-label {
  color: #8e8e93;
  font-size: 23rpx;
  font-weight: 600;
}

.hero-title {
  display: block;
  margin-top: 10rpx;
}

.input-card {
  padding: 8rpx 8rpx 18rpx;
}

.textarea {
  width: 100%;
  min-height: 330rpx;
  padding: 28rpx 26rpx;
  color: #1c1c1e;
  font-size: 31rpx;
  line-height: 1.58;
  box-sizing: border-box;
}

.input-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 22rpx;
  color: #8e8e93;
  font-size: 21rpx;
}

.error-banner {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.error-title {
  color: #a92d27;
  font-weight: 800;
}

.section-label {
  margin: 34rpx 0 12rpx 12rpx;
}

.example-list {
  padding: 2rpx 28rpx;
  overflow: hidden;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.86);
}

.example-row {
  display: flex;
  min-height: 88rpx;
  align-items: center;
  gap: 18rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
  color: #636366;
  font-size: 25rpx;
  line-height: 1.45;
}

.example-row:last-child {
  border-bottom: 0;
}

.example-dot {
  width: 16rpx;
  height: 16rpx;
  flex-shrink: 0;
  border-radius: 50%;
}

.green-dot { background: #34c759; }
.blue-dot { background: #0a84ff; }
.orange-dot { background: #ff9f0a; }

@media (max-width: 340px) {
  .textarea {
    min-height: 280rpx;
    font-size: 29rpx;
  }
}

.confirm-heading,
.section-heading,
.item-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.confirm-heading {
  padding: 16rpx 4rpx 4rpx;
}

.confirm-heading .page-title {
  display: block;
  margin-top: 5rpx;
  font-size: 44rpx;
}

.eyebrow,
.source-label,
.item-count {
  color: #8e8e93;
  font-size: 22rpx;
  font-weight: 600;
}

.confidence-badge {
  flex-shrink: 0;
  padding: 10rpx 17rpx;
  border-radius: 999rpx;
  background: rgba(52, 199, 89, 0.12);
  color: #248a3d;
  font-size: 23rpx;
  font-weight: 700;
}

.source-panel {
  margin-top: 28rpx;
  padding: 26rpx 28rpx;
  border-left: 6rpx solid #34c759;
  border-radius: 0 22rpx 22rpx 0;
  background: rgba(255, 255, 255, 0.72);
}

.source-label,
.source-text {
  display: block;
}

.source-text {
  margin-top: 9rpx;
  color: #3a3a3c;
  font-size: 26rpx;
  line-height: 1.55;
  overflow-wrap: anywhere;
}

.save-error {
  margin-top: 24rpx;
}

.section-heading {
  margin: 38rpx 8rpx 12rpx;
}

.edit-group {
  margin-top: 0;
  padding: 0 28rpx;
}

.parse-item {
  padding: 28rpx 0 30rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.12);
}

.parse-item:last-child {
  border-bottom: 0;
}

.item-heading {
  color: #1c1c1e;
  font-size: 27rpx;
  font-weight: 800;
}

.estimated-tag {
  padding: 5rpx 13rpx;
  border-radius: 999rpx;
  background: rgba(255, 159, 10, 0.12);
  color: #b66b00;
  font-size: 20rpx;
  font-weight: 700;
}

.edit-grid {
  display: grid;
  gap: 16rpx;
  margin-top: 18rpx;
}

.edit-grid.two {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.edit-grid.four {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.edit-field {
  min-width: 0;
}

.edit-label {
  display: block;
  min-height: 34rpx;
  margin-bottom: 8rpx;
  overflow: hidden;
  color: #8e8e93;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-input,
.unit-field {
  width: 100%;
  height: 72rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  border-radius: 18rpx;
  background: rgba(118, 118, 128, 0.08);
  color: #1c1c1e;
  font-size: 25rpx;
  line-height: 72rpx;
  box-sizing: border-box;
}

.unit-field {
  color: #8e8e93;
  text-align: center;
}

.inline-state {
  min-height: 220rpx;
  padding: 36rpx 12rpx;
}

@media (max-width: 340px) {
  .edit-grid.four {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .confirm-heading .page-title {
    font-size: 40rpx;
  }
}

.confirm-page {
  --confirm-bg: #f7f8f5;
  --surface: rgba(255, 255, 255, 0.92);
  --surface-soft: rgba(242, 242, 247, 0.72);
  --border: rgba(60, 60, 67, 0.1);
  --text-primary: #1c1c1e;
  --text-secondary: #636366;
  --text-tertiary: #8e8e93;
  --green: #34c759;
  --green-strong: #248a3d;
  --blue: #0a84ff;
  --orange: #ff9f0a;
  --red: #ff453a;
  min-height: 100vh;
  padding: calc(32rpx + env(safe-area-inset-top)) 32rpx 230rpx;
  background: var(--confirm-bg);
  box-sizing: border-box;
  animation: page-fade-in 250ms ease-out both;
}

.confirm-hero,
.source-card,
.section-heading,
.item-heading,
.item-title-wrap {
  display: flex;
  align-items: center;
}

.confirm-hero {
  min-height: 142rpx;
  justify-content: space-between;
  gap: 24rpx;
}

.confirm-kicker,
.confirm-title,
.confirm-subtitle,
.section-title,
.section-subtitle,
.source-label,
.source-text,
.item-title,
.item-subtitle {
  display: block;
}

.confirm-kicker,
.confirm-subtitle,
.section-subtitle,
.source-label,
.item-subtitle,
.edit-label {
  color: var(--text-tertiary);
  font-size: 23rpx;
  font-weight: 650;
}

.confirm-title {
  margin-top: 4rpx;
  color: var(--text-primary);
  font-size: 66rpx;
  line-height: 1.04;
  font-weight: 900;
}

.confirm-subtitle {
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
}

.confidence-badge {
  display: flex;
  min-width: 94rpx;
  height: 74rpx;
  flex-shrink: 0;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(52, 199, 89, 0.16);
  border-radius: 28rpx;
  background: rgba(52, 199, 89, 0.1);
}

.confidence-number {
  color: var(--green-strong);
  font-size: 25rpx;
  line-height: 1;
  font-weight: 900;
}

.confidence-label {
  margin-top: 5rpx;
  color: var(--green-strong);
  font-size: 18rpx;
  font-weight: 760;
}

.source-card,
.review-section {
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 48rpx;
  background: var(--surface);
  box-shadow: 0 12rpx 34rpx rgba(0, 0, 0, 0.045);
  -webkit-backdrop-filter: blur(28rpx);
  backdrop-filter: blur(28rpx);
  box-sizing: border-box;
}

.card-fade {
  animation: card-rise 260ms ease-out both;
}

.source-card {
  align-items: flex-start;
  gap: 18rpx;
  margin-top: 16rpx;
  padding: 28rpx;
}

.source-ai {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #1c1c1e;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
}

.source-bubble {
  min-width: 0;
  flex: 1;
  padding: 22rpx 24rpx;
  border-radius: 32rpx 32rpx 32rpx 12rpx;
  background: var(--surface-soft);
}

.source-text {
  margin-top: 8rpx;
  color: var(--text-primary);
  font-size: 27rpx;
  line-height: 1.55;
  font-weight: 620;
  overflow-wrap: anywhere;
}

.save-error {
  margin-top: 24rpx;
  border-radius: 28rpx;
}

.review-section {
  margin-top: 28rpx;
  padding: 32rpx;
}

.section-heading {
  justify-content: space-between;
  gap: 22rpx;
  margin-bottom: 22rpx;
}

.section-title {
  color: var(--text-primary);
  font-size: 35rpx;
  line-height: 1.22;
  font-weight: 860;
}

.section-subtitle {
  margin-top: 5rpx;
  font-size: 22rpx;
}

.parse-item {
  padding: 24rpx 0 28rpx;
  border-top: 1rpx solid var(--border);
}

.parse-item:first-of-type {
  border-top: 0;
  padding-top: 0;
}

.parse-item:last-child {
  padding-bottom: 0;
}

.item-heading {
  justify-content: space-between;
  gap: 20rpx;
}

.item-title-wrap {
  min-width: 0;
  gap: 16rpx;
}

.item-icon {
  display: flex;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: rgba(52, 199, 89, 0.12);
  color: var(--green-strong);
  font-size: 22rpx;
  font-weight: 900;
}

.item-icon-blue {
  background: rgba(10, 132, 255, 0.12);
  color: var(--blue);
}

.item-title {
  color: var(--text-primary);
  font-size: 29rpx;
  line-height: 1.25;
  font-weight: 840;
}

.item-subtitle {
  margin-top: 3rpx;
  font-size: 20rpx;
}

.estimated-tag {
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 159, 10, 0.12);
  color: #b66b00;
  font-size: 20rpx;
  font-weight: 760;
}

.edit-grid,
.macro-edit-grid {
  display: grid;
  gap: 16rpx;
  margin-top: 20rpx;
}

.edit-grid.two {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.macro-edit-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.edit-field {
  min-width: 0;
}

.edit-label {
  min-height: 34rpx;
  margin-bottom: 8rpx;
  overflow: hidden;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-input,
.unit-field {
  width: 100%;
  height: 74rpx;
  padding: 0 18rpx;
  border: 1rpx solid rgba(60, 60, 67, 0.06);
  border-radius: 22rpx;
  background: rgba(242, 242, 247, 0.72);
  color: var(--text-primary);
  font-size: 25rpx;
  line-height: 74rpx;
  font-weight: 650;
  box-sizing: border-box;
}

.number-input {
  font-weight: 820;
}

.unit-field {
  color: var(--text-tertiary);
  text-align: center;
}

.inline-state {
  min-height: 220rpx;
  padding: 36rpx 12rpx;
}

.action-dock {
  position: fixed;
  right: 22rpx;
  bottom: calc(env(safe-area-inset-bottom) + 18rpx);
  left: 22rpx;
  z-index: 10;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 190rpx;
  gap: 12rpx;
  padding: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 44rpx;
  background: rgba(248, 248, 250, 0.9);
  box-shadow: 0 18rpx 48rpx rgba(28, 28, 30, 0.11);
  -webkit-backdrop-filter: blur(34rpx);
  backdrop-filter: blur(34rpx);
  box-sizing: border-box;
}

.save-button,
.secondary-button {
  height: 76rpx;
  min-height: 76rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 32rpx;
  font-size: 26rpx;
  line-height: 76rpx;
  font-weight: 820;
}

.save-button {
  background: #1c1c1e;
  color: #ffffff;
}

.secondary-button {
  background: rgba(118, 118, 128, 0.12);
  color: var(--text-primary);
}

.save-button::after,
.secondary-button::after {
  border: 0;
}

.button-press {
  transition: opacity 250ms ease-out, transform 250ms ease-out;
}

.button-press:active {
  opacity: 0.78;
  transform: scale(0.975);
}

@keyframes page-fade-in {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes card-rise {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 340px) {
  .confirm-page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .confirm-hero {
    align-items: flex-start;
    flex-direction: column;
  }

  .edit-grid.two,
  .macro-edit-grid {
    grid-template-columns: 1fr;
  }

  .action-dock {
    grid-template-columns: 1fr;
  }
}

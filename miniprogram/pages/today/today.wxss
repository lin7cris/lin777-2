.today-root {
  --native-tabbar-height: 112rpx;
  --composer-gap: 20rpx;
  --composer-reserve: 128rpx;
  min-height: 100vh;
  height: 100vh;
  background: #f7f8f5;
}

.today-page {
  --today-bg: #f7f8f5;
  --surface: rgba(255, 255, 255, 0.92);
  --surface-soft: rgba(242, 242, 247, 0.74);
  --border: rgba(60, 60, 67, 0.1);
  --text-primary: #1c1c1e;
  --text-secondary: #636366;
  --text-tertiary: #8e8e93;
  --green: #34c759;
  --green-strong: #248a3d;
  --blue: #0a84ff;
  --red: #ff453a;
  height: 100vh;
  padding: calc(32rpx + env(safe-area-inset-top)) 32rpx calc(var(--native-tabbar-height) + var(--composer-gap) + var(--composer-reserve) + env(safe-area-inset-bottom));
  background: var(--today-bg);
  box-sizing: border-box;
  animation: page-fade-in 250ms ease-out both;
}

.today-hero,
.section-heading,
.metric-strip,
.macro-head,
.timeline-row {
  display: flex;
  align-items: center;
}

.today-hero {
  justify-content: space-between;
  gap: 28rpx;
  min-height: 142rpx;
}

.today-kicker,
.section-subtitle,
.metric-label,
.metric-unit,
.record-count,
.record-meta {
  color: var(--text-tertiary);
  font-size: 23rpx;
  font-weight: 650;
}

.today-kicker,
.today-title,
.today-date,
.section-title,
.section-subtitle {
  display: block;
}

.today-title {
  margin-top: 4rpx;
  color: var(--text-primary);
  font-size: 66rpx;
  line-height: 1.04;
  font-weight: 850;
  letter-spacing: 0;
}

.today-date {
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: 27rpx;
  font-weight: 650;
}

.goal-tag {
  display: flex;
  min-width: 118rpx;
  height: 56rpx;
  align-items: center;
  justify-content: center;
  padding: 0 22rpx;
  border: 1rpx solid rgba(52, 199, 89, 0.16);
  border-radius: 999rpx;
  background: rgba(52, 199, 89, 0.1);
  color: var(--green-strong);
  font-size: 24rpx;
  font-weight: 780;
  box-sizing: border-box;
}

.apple-card,
.goal-card,
.metric-strip {
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  background: var(--surface);
  box-shadow: 0 12rpx 34rpx rgba(0, 0, 0, 0.045);
  -webkit-backdrop-filter: blur(28rpx);
  backdrop-filter: blur(28rpx);
  box-sizing: border-box;
}

.card-fade {
  animation: card-rise 260ms ease-out both;
}

.goal-card {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 132rpx;
  gap: 18rpx;
  align-items: center;
  margin-top: 16rpx;
  padding: 44rpx 34rpx 42rpx;
  border-radius: 48rpx;
}

.goal-copy {
  min-width: 0;
}

.goal-eyebrow {
  display: block;
  color: var(--text-tertiary);
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 760;
}

.goal-title {
  display: block;
  margin-top: 8rpx;
  color: var(--text-primary);
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 820;
}

.deficit-line {
  display: flex;
  width: 100%;
  min-width: 0;
  align-items: flex-end;
  gap: 8rpx;
  margin-top: 26rpx;
  overflow: visible;
}

.deficit-number {
  flex-shrink: 1;
  min-width: 0;
  overflow: visible;
  font-size: 108rpx;
  line-height: 0.88;
  font-weight: 950;
  white-space: nowrap;
}

.deficit-size-large .deficit-number {
  font-size: 112rpx;
}

.deficit-size-medium .deficit-number {
  font-size: 92rpx;
  letter-spacing: 0;
}

.deficit-size-compact .deficit-number {
  font-size: 78rpx;
  letter-spacing: 0;
}

.deficit-unit {
  flex-shrink: 0;
  padding-bottom: 10rpx;
  font-size: 26rpx;
  line-height: 1;
  font-weight: 850;
}

.goal-subtitle {
  display: block;
  margin-top: 24rpx;
  color: var(--text-secondary);
  font-size: 29rpx;
  line-height: 1.46;
  font-weight: 680;
}

.goal-ring {
  display: flex;
  width: 132rpx;
  height: 132rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: conic-gradient(var(--green) 0 70%, rgba(118, 118, 128, 0.14) 70% 100%);
  box-shadow: none;
}

.goal-ring-inner {
  display: flex;
  width: 94rpx;
  height: 94rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
}

.goal-progress {
  color: var(--text-primary);
  font-size: 29rpx;
  line-height: 1;
  font-weight: 900;
}

.metric-strip {
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 24rpx;
  padding: 22rpx;
  border-radius: 48rpx;
}

.nutrition-coach-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  min-height: 132rpx;
  margin-top: 28rpx;
  padding: 30rpx 32rpx;
}

.nutrition-coach-entry-copy {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.nutrition-coach-entry-title {
  color: var(--text-primary);
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 840;
}

.nutrition-coach-entry-subtitle {
  margin-top: 8rpx;
  color: var(--text-secondary);
  font-size: 25rpx;
  line-height: 1.4;
  font-weight: 560;
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.nutrition-coach-entry-action {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  padding: 0;
  border-radius: 999rpx;
  background: rgba(52, 199, 89, 0.12);
  color: var(--green-strong);
  font-size: 24rpx;
  line-height: 1;
  font-weight: 800;
}

.nutrition-coach-entry-arrow {
  margin-top: -4rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.metric-item {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 104rpx;
  border-right: 0;
  border-radius: 30rpx;
  background: rgba(242, 242, 247, 0.55);
}

.metric-number-line {
  display: flex;
  min-width: 0;
  align-items: baseline;
  justify-content: center;
  gap: 5rpx;
}

.metric-value {
  max-width: 100%;
  overflow: hidden;
  color: var(--text-primary);
  font-size: 43rpx;
  line-height: 1;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric-label {
  margin-top: 10rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.metric-unit {
  color: var(--text-tertiary);
  font-size: 18rpx;
  font-weight: 760;
}

.apple-card {
  margin-top: 28rpx;
  padding: 32rpx;
  border-radius: 48rpx;
}

.section-heading {
  justify-content: space-between;
  gap: 22rpx;
}

.section-title {
  color: var(--text-primary);
  font-size: 35rpx;
  line-height: 1.22;
  font-weight: 840;
}

.section-subtitle {
  margin-top: 5rpx;
  font-size: 22rpx;
}

.section-caption {
  color: var(--text-tertiary);
  font-size: 22rpx;
  font-weight: 700;
}

.macro-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
  margin-top: 26rpx;
}

.macro-tile {
  padding: 22rpx;
  border-radius: 28rpx;
  background: var(--surface-soft);
}

.macro-head {
  justify-content: space-between;
  gap: 16rpx;
}

.macro-name {
  color: var(--text-primary);
  font-size: 27rpx;
  font-weight: 800;
}

.macro-percent {
  color: var(--text-secondary);
  font-size: 23rpx;
  font-weight: 760;
}

.macro-value {
  display: block;
  margin-top: 6rpx;
  color: var(--text-tertiary);
  font-size: 22rpx;
  font-weight: 650;
}

.macro-track {
  height: 10rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(118, 118, 128, 0.14);
}

.macro-fill {
  height: 100%;
  max-width: 100%;
  border-radius: 999rpx;
}

.macro-fill.green { background: var(--green); }
.macro-fill.amber { background: #ff9f0a; }
.macro-fill.red { background: var(--blue); }

.coach-card {
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.96), rgba(248, 248, 250, 0.9));
}

.coach-mark {
  display: flex;
  width: 52rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #1c1c1e;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 850;
}

.coach-bubble {
  display: grid;
  grid-template-columns: 54rpx minmax(0, 1fr);
  gap: 18rpx;
  align-items: start;
  margin-top: 28rpx;
}

.coach-avatar {
  display: flex;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #1c1c1e;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 900;
}

.coach-message {
  padding: 24rpx 24rpx 22rpx;
  border-radius: 32rpx 32rpx 32rpx 12rpx;
  background: rgba(242, 242, 247, 0.76);
}

.coach-summary {
  display: block;
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.55;
  font-weight: 700;
}

.coach-list {
  display: grid;
  gap: 16rpx;
  margin-top: 22rpx;
}

.coach-item {
  display: grid;
  grid-template-columns: 14rpx minmax(0, 1fr);
  gap: 16rpx;
  align-items: start;
  color: var(--text-secondary);
  font-size: 25rpx;
  line-height: 1.5;
  font-weight: 620;
}

.coach-dot {
  width: 9rpx;
  height: 9rpx;
  margin-top: 15rpx;
  border-radius: 50%;
  background: var(--green);
}

.timeline {
  position: relative;
  margin-top: 22rpx;
}

.timeline-row {
  align-items: stretch;
  gap: 14rpx;
  min-height: 116rpx;
}

.timeline-rail {
  display: flex;
  width: 28rpx;
  flex-shrink: 0;
  justify-content: center;
  padding-top: 42rpx;
  background: linear-gradient(90deg, transparent 0 12rpx, rgba(60, 60, 67, 0.1) 12rpx 14rpx, transparent 14rpx 100%);
}

.timeline-row:first-child .timeline-rail {
  background: linear-gradient(180deg, transparent 0 42rpx, rgba(60, 60, 67, 0.1) 42rpx 100%);
  background-size: 2rpx 100%;
  background-position: center;
  background-repeat: no-repeat;
}

.timeline-dot {
  width: 15rpx;
  height: 15rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 0 1rpx rgba(52, 199, 89, 0.18);
  box-sizing: border-box;
}

.swipe-shell {
  width: 100%;
  min-width: 0;
  white-space: nowrap;
}

.swipe-content {
  display: inline-flex;
  width: calc(100% - 0rpx);
  min-height: 104rpx;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 28rpx;
  background: rgba(247, 247, 249, 0.84);
  box-sizing: border-box;
  vertical-align: top;
}

.record-thumb {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: rgba(52, 199, 89, 0.12);
  color: var(--green-strong);
  font-size: 23rpx;
  font-weight: 850;
}

.record-thumb-blue {
  background: rgba(10, 132, 255, 0.12);
  color: var(--blue);
}

.record-content {
  min-width: 0;
  flex: 1;
}

.record-title {
  overflow: hidden;
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.28;
  font-weight: 780;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-meta {
  margin-top: 5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-calories {
  flex-shrink: 0;
  color: var(--text-primary);
  font-size: 25rpx;
  font-weight: 820;
}

.swipe-delete {
  display: inline-flex;
  width: 126rpx;
  height: 104rpx;
  min-height: 104rpx;
  align-items: center;
  justify-content: center;
  margin: 0 0 0 12rpx;
  padding: 0;
  border: 0;
  border-radius: 28rpx;
  background: rgba(255, 69, 58, 0.12);
  color: #c9342c;
  font-size: 24rpx;
  line-height: 104rpx;
  font-weight: 780;
  vertical-align: top;
}

.swipe-delete::after {
  border: 0;
}

.delete-button-disabled {
  opacity: 0.52;
}

.timeline-skeleton {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 32rpx 0 10rpx;
}

.timeline-skeleton-avatar {
  width: 62rpx;
  height: 62rpx;
  border-radius: 18rpx;
}

.timeline-skeleton-lines {
  flex: 1;
}

.skeleton-line {
  width: 78%;
  height: 28rpx;
}

.skeleton-line.short {
  width: 48%;
  height: 22rpx;
  margin-top: 18rpx;
}

.compact-state {
  min-height: 260rpx;
  padding: 38rpx 18rpx 20rpx;
}

.empty-orbit {
  width: 76rpx;
  height: 76rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid rgba(52, 199, 89, 0.22);
  border-radius: 50%;
  background: radial-gradient(circle, rgba(52, 199, 89, 0.2) 0 16rpx, transparent 17rpx);
}

.input-dock {
  position: fixed;
  right: 0;
  bottom: calc(var(--native-tabbar-height) + var(--composer-gap) + env(safe-area-inset-bottom));
  left: 0;
  z-index: 999;
  padding: 0 32rpx;
  box-sizing: border-box;
  transition: bottom 250ms ease-out, opacity 250ms ease-out, transform 250ms ease-out;
}

.recent-foods-panel {
  margin-bottom: 12rpx;
  padding: 16rpx 18rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.82);
  border-radius: 32rpx;
  background: rgba(248, 248, 250, 0.92);
  box-shadow: 0 10rpx 30rpx rgba(28, 28, 30, 0.07);
  -webkit-backdrop-filter: blur(30rpx);
  backdrop-filter: blur(30rpx);
  box-sizing: border-box;
}

.recent-foods-title {
  display: block;
  margin: 0 4rpx 10rpx;
  color: #636366;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 760;
}

.recent-foods-scroll {
  width: 100%;
  white-space: nowrap;
}

.recent-foods-row {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding-right: 4rpx;
}

.recent-food-chip {
  display: inline-flex;
  max-width: 210rpx;
  height: 58rpx;
  min-height: 58rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0 22rpx;
  overflow: hidden;
  border: 1rpx solid rgba(60, 60, 67, 0.08);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.96);
  color: #1c1c1e;
  font-size: 24rpx;
  line-height: 58rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
  box-sizing: border-box;
}

.recent-food-chip::after {
  border: 0;
}

.button-press {
  transition: opacity 250ms ease-out, transform 250ms ease-out;
}

.button-press:active {
  opacity: 0.78;
  transform: scale(0.975);
}

.blue-text {
  color: var(--blue);
}

.success-text {
  color: var(--green-strong);
}

.danger-text {
  color: var(--red);
}

.ai-error {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin: 0 0 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  font-size: 23rpx;
}

.error-title {
  color: #a92d27;
  font-weight: 800;
}

@keyframes page-fade-in {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes card-rise {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 340px) {
  .today-page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .input-dock {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .goal-card {
    grid-template-columns: 1fr;
  }

  .goal-ring {
    margin: 0 auto;
  }

  .deficit-size-large .deficit-number {
    font-size: 98rpx;
  }

  .deficit-size-medium .deficit-number {
    font-size: 84rpx;
  }

  .deficit-size-compact .deficit-number {
    font-size: 72rpx;
  }

  .metric-value {
    font-size: 32rpx;
  }
}

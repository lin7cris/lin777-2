.page {
  padding-bottom: 340rpx;
}

.page-heading,
.section-heading,
.stat-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.page-heading {
  min-height: 92rpx;
}

.page-heading .page-title {
  display: block;
  margin-top: 4rpx;
  font-size: 48rpx;
}

.eyebrow {
  display: block;
  color: #8e8e93;
  font-size: 23rpx;
  font-weight: 600;
}

.overview-card {
  padding: 36rpx 32rpx;
}

.summary {
  display: grid;
  grid-template-columns: 248rpx minmax(0, 1fr);
  gap: 34rpx;
  align-items: center;
}

.calorie-ring {
  width: 248rpx;
  height: 248rpx;
  padding: 14rpx;
  border-radius: 50%;
  background: conic-gradient(#34c759 0 72%, rgba(52, 199, 89, 0.13) 72% 100%);
  box-shadow: 0 12rpx 30rpx rgba(52, 199, 89, 0.14);
  box-sizing: border-box;
}

.calorie-ring-inner {
  display: flex;
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.96);
}

.ring-number {
  max-width: 190rpx;
  overflow: hidden;
  color: #1c1c1e;
  font-size: 58rpx;
  line-height: 1.05;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ring-label {
  margin-top: 8rpx;
  color: #8e8e93;
  font-size: 22rpx;
  font-weight: 600;
}

.stat-list {
  display: flex;
  min-width: 0;
  flex-direction: column;
}

.stat-row {
  min-height: 62rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}

.stat-row:last-child {
  border-bottom: 0;
}

.stat-label,
.section-caption,
.record-count {
  color: #8e8e93;
  font-size: 23rpx;
}

.stat-value {
  color: #1c1c1e;
  font-size: 30rpx;
  font-weight: 700;
}

.blue-text {
  color: #0a84ff;
}

.nutrition-card,
.records-card {
  padding-top: 30rpx;
}

.macro {
  margin-top: 26rpx;
}

.macro .row {
  font-size: 26rpx;
}

.track {
  height: 12rpx;
  margin-top: 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(118, 118, 128, 0.12);
}

.fill {
  height: 100%;
  border-radius: 999rpx;
}

.fill.green { background: #34c759; }
.fill.amber { background: #ff9f0a; }
.fill.red { background: #0a84ff; }

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
}

.quick-action {
  height: 82rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 0;
  border-radius: 22rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #1c1c1e;
  font-size: 27rpx;
  line-height: 82rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.quick-action::after {
  border: 0;
}

.primary-quick {
  background: #34c759;
  color: #ffffff;
}

.loading-list {
  padding: 34rpx 0 18rpx;
}

.skeleton-line {
  width: 78%;
  height: 28rpx;
}

.skeleton-line.short {
  width: 48%;
  height: 22rpx;
  margin-top: 18rpx;
}

.compact-state {
  min-height: 260rpx;
  padding: 38rpx 18rpx 20rpx;
}

.empty-symbol {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  border-radius: 50%;
  background: rgba(52, 199, 89, 0.12);
  color: #248a3d;
  font-size: 42rpx;
  font-weight: 400;
}

.record {
  min-height: 104rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
  box-sizing: border-box;
}

.record:last-child {
  border-bottom: 0;
}

.record-content {
  min-width: 0;
  flex: 1;
}

.record-title {
  overflow-wrap: anywhere;
  font-size: 28rpx;
  font-weight: 700;
}

.small {
  margin-top: 4rpx;
  font-size: 23rpx;
}

.record-actions {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  gap: 14rpx;
}

.record-calories {
  color: #1c1c1e;
  font-size: 25rpx;
  font-weight: 700;
  white-space: nowrap;
}

.delete-button {
  width: 82rpx;
  height: 54rpx;
  min-height: 54rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 16rpx;
  background: rgba(255, 69, 58, 0.1);
  color: #c9342c;
  font-size: 22rpx;
  line-height: 54rpx;
}

.delete-button::after {
  border: 0;
}

.delete-button-disabled {
  opacity: 0.52;
}

.input-dock {
  position: fixed;
  right: 22rpx;
  bottom: calc(env(safe-area-inset-bottom) + 18rpx);
  left: 22rpx;
  z-index: 10;
  padding: 16rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 28rpx;
  background: rgba(248, 248, 250, 0.9);
  box-shadow: 0 18rpx 48rpx rgba(28, 28, 30, 0.12);
  -webkit-backdrop-filter: blur(30rpx);
  backdrop-filter: blur(30rpx);
  box-sizing: border-box;
}

.input-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 154rpx;
  gap: 14rpx;
  align-items: end;
}

.daily-input {
  width: 100%;
  min-height: 72rpx;
  max-height: 172rpx;
  padding: 17rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(118, 118, 128, 0.09);
  color: #1c1c1e;
  font-size: 26rpx;
  line-height: 1.45;
  box-sizing: border-box;
}

.parse-button {
  height: 72rpx;
  margin: 0;
  padding: 0 12rpx;
  border: 0;
  border-radius: 20rpx;
  background: #34c759;
  color: #ffffff;
  font-size: 25rpx;
  line-height: 72rpx;
  font-weight: 700;
}

.parse-button::after {
  border: 0;
}

.ai-error {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  margin: 0 0 14rpx;
  padding: 16rpx 18rpx;
  font-size: 23rpx;
}

.error-title {
  color: #a92d27;
  font-weight: 800;
}

@media (max-width: 340px) {
  .summary {
    grid-template-columns: 1fr;
  }

  .calorie-ring {
    margin: 0 auto;
  }

  .stat-list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 24rpx;
  }

  .input-row {
    grid-template-columns: minmax(0, 1fr) 132rpx;
  }
}

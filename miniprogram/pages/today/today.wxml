<view class="page">
  <view class="page-heading">
    <view>
      <text class="eyebrow">今日概览</text>
      <text class="page-title">{{dateTitle}}</text>
    </view>
    <text class="pill">{{goalLabel}}</text>
  </view>

  <view class="card overview-card">
    <view class="summary">
      <view class="calorie-ring">
        <view class="calorie-ring-inner">
          <text class="ring-number">{{netCalories}}</text>
          <text class="ring-label">净摄入 kcal</text>
        </view>
      </view>
      <view class="stat-list">
        <view class="stat-row"><text class="stat-label">推荐</text><text class="stat-value">{{targetCalories}}</text></view>
        <view class="stat-row"><text class="stat-label">摄入</text><text class="stat-value">{{foodCalories}}</text></view>
        <view class="stat-row"><text class="stat-label">运动</text><text class="stat-value blue-text">-{{exerciseCalories}}</text></view>
        <view class="stat-row"><text class="stat-label">剩余</text><text class="stat-value">{{remainingCalories}}</text></view>
      </view>
    </view>
  </view>

  <view class="card nutrition-card">
    <view class="section-heading">
      <text class="card-title">营养素</text>
      <text class="section-caption">今日进度</text>
    </view>
    <view class="macro" wx:for="{{macros}}" wx:key="name">
      <view class="row"><text>{{item.name}}</text><text class="value">{{item.value}}</text></view>
      <view class="track"><view class="fill {{item.color}}" style="width: {{item.percent}}%;"></view></view>
    </view>
  </view>

  <view class="actions">
    <button class="quick-action primary-quick" bindtap="goEntry">记录饮食</button>
    <button class="quick-action" bindtap="goEntry">记录运动</button>
  </view>

  <view class="card records-card">
    <view class="section-heading">
      <text class="card-title">今日记录</text>
      <text class="record-count" wx:if="{{records.length}}">{{records.length}} 条</text>
    </view>

    <view wx:if="{{loadingRecords}}" class="loading-list">
      <view class="skeleton skeleton-line"></view>
      <view class="skeleton skeleton-line short"></view>
    </view>

    <view wx:elif="{{recordError}}" class="state-view compact-state">
      <text class="state-title">记录暂时无法载入</text>
      <text class="state-copy">{{recordError}}</text>
      <button class="state-action" bindtap="retryDailyRecord">重新加载</button>
    </view>

    <view wx:elif="{{!records.length}}" class="state-view compact-state">
      <text class="empty-symbol">＋</text>
      <text class="state-title">还没有今日记录</text>
      <text class="state-copy">写下今天吃了什么或完成了哪些运动。</text>
    </view>

    <block wx:else>
      <view class="record row" wx:for="{{records}}" wx:key="id">
        <view class="record-content">
          <view class="record-title">{{item.title}}</view>
          <view class="muted small">{{item.desc}}</view>
        </view>
        <view class="record-actions">
          <text class="record-calories {{item.type === 'exercise' ? 'blue-text' : ''}}">{{item.calories}}</text>
          <button
            class="delete-button {{deletingId ? 'delete-button-disabled' : ''}}"
            loading="{{deletingId === item.id}}"
            disabled="{{!!deletingId}}"
            data-item-type="{{item.itemType}}"
            data-item-id="{{item.id}}"
            data-title="{{item.title}}"
            bindtap="deleteDailyItem"
          >删除</button>
        </view>
      </view>
    </block>
  </view>

  <view class="input-dock">
    <view wx:if="{{aiError}}" class="error-banner ai-error">
      <text class="error-title">AI 解析失败</text>
      <text>{{aiError}}</text>
    </view>
    <view class="input-row">
      <textarea
        class="daily-input"
        value="{{dailyInput}}"
        placeholder="描述饮食或运动..."
        maxlength="500"
        auto-height
        bindinput="onDailyInput"
      />
      <button class="parse-button" loading="{{parsing}}" disabled="{{parsing}}" bindtap="parseDailyInput">AI 解析</button>
    </view>
  </view>
</view>

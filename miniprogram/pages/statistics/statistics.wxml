<view class="page statistics-page">
  <view class="statistics-header">
    <view>
      <view class="eyebrow">健康趋势</view>
      <view class="page-title">统计分析</view>
    </view>
    <view class="segmented-control">
      <button class="segment {{rangeDays === 7 ? 'segment-active' : ''}}" data-days="7" bindtap="selectRange">7 天</button>
      <button class="segment {{rangeDays === 30 ? 'segment-active' : ''}}" data-days="30" bindtap="selectRange">30 天</button>
    </view>
  </view>

  <view class="state-view" wx:if="{{loading}}">
    <view class="loading-chart"><view class="skeleton chart-skeleton one"></view><view class="skeleton chart-skeleton two"></view><view class="skeleton chart-skeleton three"></view></view>
    <view class="state-copy">正在生成趋势...</view>
  </view>

  <view class="state-view error-state" wx:elif="{{statisticsError}}">
    <view class="state-icon error-icon">!</view>
    <view class="state-title">统计暂时无法载入</view>
    <view class="state-copy">{{statisticsError}}</view>
    <button class="state-action" bindtap="retryStatistics">重新加载</button>
  </view>

  <view class="state-view empty-state" wx:elif="{{!hasData}}">
    <view class="empty-lines"><view></view><view></view><view></view></view>
    <view class="state-title">还没有趋势数据</view>
    <view class="state-copy">记录饮食或运动后，这里会自动生成趋势。</view>
  </view>

  <block wx:else>
    <view class="trend-card">
      <view class="trend-heading"><view><text class="trend-title">摄入热量趋势</text><text class="trend-subtitle">每日饮食总热量</text></view><text class="unit">kcal</text></view>
      <view class="chart">
        <view class="chart-point" wx:for="{{intake.points}}" wx:key="dateKey"><view class="bar-track"><view class="trend-bar intake-bar" style="height: {{item.height}}rpx;"></view></view><text class="axis-label">{{item.showLabel ? item.label : ''}}</text></view>
      </view>
    </view>

    <view class="trend-card">
      <view class="trend-heading"><view><text class="trend-title">运动消耗趋势</text><text class="trend-subtitle">每日运动消耗</text></view><text class="unit">kcal</text></view>
      <view class="chart">
        <view class="chart-point" wx:for="{{exercise.points}}" wx:key="dateKey"><view class="bar-track"><view class="trend-bar exercise-bar" style="height: {{item.height}}rpx;"></view></view><text class="axis-label">{{item.showLabel ? item.label : ''}}</text></view>
      </view>
    </view>

    <view class="trend-card">
      <view class="trend-heading"><view><text class="trend-title">净摄入趋势</text><text class="trend-subtitle">摄入减去运动</text></view><text class="unit">kcal</text></view>
      <view class="chart">
        <view class="chart-point" wx:for="{{net.points}}" wx:key="dateKey"><view class="bar-track"><view class="trend-bar {{item.negative ? 'net-negative' : 'net-positive'}}" style="height: {{item.height}}rpx;"></view></view><text class="axis-label">{{item.showLabel ? item.label : ''}}</text></view>
      </view>
    </view>

    <view class="trend-card">
      <view class="trend-heading"><view><text class="trend-title">体重趋势</text><text class="trend-subtitle">保存记录时的体重快照</text></view><text class="unit">kg</text></view>
      <view class="chart" wx:if="{{weight.hasData}}">
        <view class="chart-point" wx:for="{{weight.points}}" wx:key="dateKey"><view class="bar-track"><view class="trend-bar weight-bar {{item.hasValue ? '' : 'bar-empty'}}" style="height: {{item.height}}rpx;"></view></view><text class="axis-label">{{item.showLabel ? item.label : ''}}</text></view>
      </view>
      <view class="chart-empty" wx:else>当前范围内还没有体重快照</view>
    </view>
  </block>
</view>

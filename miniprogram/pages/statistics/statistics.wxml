<view class="page statistics-page">
  <view class="statistics-hero">
    <view>
      <text class="statistics-kicker">Trends</text>
      <text class="statistics-title">统计</text>
      <text class="statistics-subtitle">最近 {{rangeDays}} 天健康趋势</text>
    </view>
    <view class="segmented-control">
      <button class="segment {{rangeDays === 7 ? 'segment-active' : ''}}" data-days="7" bindtap="selectRange">7 天</button>
      <button class="segment {{rangeDays === 30 ? 'segment-active' : ''}}" data-days="30" bindtap="selectRange">30 天</button>
    </view>
  </view>

  <view class="state-card" wx:if="{{loading}}">
    <view class="loading-chart">
      <view class="skeleton chart-skeleton one"></view>
      <view class="skeleton chart-skeleton two"></view>
      <view class="skeleton chart-skeleton three"></view>
    </view>
    <view class="state-copy">正在生成趋势...</view>
  </view>

  <view class="state-card error-state" wx:elif="{{statisticsError}}">
    <view class="state-orb error-orb">!</view>
    <view class="state-title">统计暂时无法载入</view>
    <view class="state-copy">{{statisticsError}}</view>
    <button class="state-action button-press" bindtap="retryStatistics">重新加载</button>
  </view>

  <view class="state-card empty-state" wx:elif="{{!hasData}}">
    <view class="empty-chart">
      <view></view><view></view><view></view>
    </view>
    <view class="state-title">还没有趋势数据</view>
    <view class="state-copy">记录饮食或运动后，这里会自动生成趋势。</view>
  </view>

  <block wx:else>
    <view class="overview-card card-fade">
      <view class="overview-heading">
        <text class="overview-title">近期概览</text>
        <text class="overview-caption">最近 7 天与 30 天</text>
      </view>
      <view class="overview-grid">
        <view class="overview-metric">
          <text class="overview-label">7天平均摄入</text>
          <view class="overview-value-row">
            <text class="overview-value">{{overview.averageIntake7Text}}</text>
            <text wx:if="{{overview.averageIntake7Text !== '--'}}" class="overview-unit">kcal/天</text>
          </view>
        </view>
        <view class="overview-metric">
          <text class="overview-label">30天平均摄入</text>
          <view class="overview-value-row">
            <text class="overview-value">{{overview.averageIntake30Text}}</text>
            <text wx:if="{{overview.averageIntake30Text !== '--'}}" class="overview-unit">kcal/天</text>
          </view>
        </view>
        <view class="overview-metric">
          <text class="overview-label">{{overview.calorieBalanceTitle}}</text>
          <view class="overview-value-row">
            <text class="overview-value {{overview.calorieBalanceTitle === '平均热量盈余' ? 'overview-value-danger' : ''}}">{{overview.averageCalorieBalanceText}}</text>
            <text wx:if="{{overview.averageCalorieBalanceText !== '--'}}" class="overview-unit">kcal/天</text>
          </view>
        </view>
        <view class="overview-metric">
          <text class="overview-label">蛋白质达标率</text>
          <view class="overview-value-row">
            <text class="overview-value">{{overview.proteinAchievementText}}</text>
          </view>
        </view>
        <view class="overview-metric overview-metric-wide">
          <view>
            <text class="overview-label">连续记录</text>
            <text class="overview-note">从今天开始计算有效饮食记录</text>
          </view>
          <text class="overview-value overview-streak">{{overview.streakText}}</text>
        </view>
      </view>
    </view>

    <view class="trend-card primary-trend card-fade">
      <view class="trend-heading">
        <view>
          <text class="trend-label">Primary Metric</text>
          <text class="trend-title">热量缺口趋势</text>
          <text class="trend-subtitle">目标消耗加运动减饮食</text>
        </view>
        <view class="trend-meta">
          <view wx:if="{{selectedTrend && selectedTrend.chart === 'deficit'}}" class="selected-trend-value">
            <text class="selected-trend-date">{{selectedTrend.dateLabel}}</text>
            <text>{{selectedTrend.valueText}}</text>
          </view>
          <text wx:else class="unit">kcal</text>
        </view>
      </view>
      <view class="chart hero-chart">
        <view
          class="chart-point {{selectedTrend && selectedTrend.chart === 'deficit' && selectedTrend.index === index ? 'chart-point-selected' : ''}}"
          wx:for="{{deficit.points}}"
          wx:key="dateKey"
          data-chart="deficit"
          data-title="热量缺口趋势"
          data-unit="kcal"
          data-index="{{index}}"
          bindtap="selectTrendPoint"
        >
          <view class="bar-track"><view class="trend-bar {{item.negative ? 'deficit-negative' : 'deficit-positive'}}" style="height: {{item.height}}rpx;"></view></view>
          <text class="axis-label">{{item.showLabel ? item.label : ''}}</text>
        </view>
      </view>
    </view>

    <view class="trend-card card-fade">
      <view class="trend-heading">
        <view>
          <text class="trend-title">摄入热量趋势</text>
          <text class="trend-subtitle">每日饮食总热量</text>
        </view>
        <view class="trend-meta">
          <view wx:if="{{selectedTrend && selectedTrend.chart === 'intake'}}" class="selected-trend-value">
            <text class="selected-trend-date">{{selectedTrend.dateLabel}}</text>
            <text>{{selectedTrend.valueText}}</text>
          </view>
          <text wx:else class="unit">kcal</text>
        </view>
      </view>
      <view class="chart">
        <view
          class="chart-point {{selectedTrend && selectedTrend.chart === 'intake' && selectedTrend.index === index ? 'chart-point-selected' : ''}}"
          wx:for="{{intake.points}}"
          wx:key="dateKey"
          data-chart="intake"
          data-title="摄入热量趋势"
          data-unit="kcal"
          data-index="{{index}}"
          bindtap="selectTrendPoint"
        >
          <view class="bar-track"><view class="trend-bar intake-bar" style="height: {{item.height}}rpx;"></view></view>
          <text class="axis-label">{{item.showLabel ? item.label : ''}}</text>
        </view>
      </view>
    </view>

    <view class="trend-card card-fade">
      <view class="trend-heading">
        <view>
          <text class="trend-title">运动消耗趋势</text>
          <text class="trend-subtitle">每日运动消耗</text>
        </view>
        <view class="trend-meta">
          <view wx:if="{{selectedTrend && selectedTrend.chart === 'exercise'}}" class="selected-trend-value">
            <text class="selected-trend-date">{{selectedTrend.dateLabel}}</text>
            <text>{{selectedTrend.valueText}}</text>
          </view>
          <text wx:else class="unit">kcal</text>
        </view>
      </view>
      <view class="chart">
        <view
          class="chart-point {{selectedTrend && selectedTrend.chart === 'exercise' && selectedTrend.index === index ? 'chart-point-selected' : ''}}"
          wx:for="{{exercise.points}}"
          wx:key="dateKey"
          data-chart="exercise"
          data-title="运动消耗趋势"
          data-unit="kcal"
          data-index="{{index}}"
          bindtap="selectTrendPoint"
        >
          <view class="bar-track"><view class="trend-bar exercise-bar" style="height: {{item.height}}rpx;"></view></view>
          <text class="axis-label">{{item.showLabel ? item.label : ''}}</text>
        </view>
      </view>
    </view>

    <view class="trend-card card-fade">
      <view class="trend-heading">
        <view>
          <text class="trend-title">体重趋势</text>
          <text class="trend-subtitle">保存记录时的体重快照</text>
        </view>
        <view class="trend-meta">
          <view wx:if="{{selectedTrend && selectedTrend.chart === 'weight'}}" class="selected-trend-value">
            <text class="selected-trend-date">{{selectedTrend.dateLabel}}</text>
            <text>{{selectedTrend.valueText}}</text>
          </view>
          <text wx:else class="unit">kg</text>
        </view>
      </view>
      <view class="chart" wx:if="{{weight.hasData}}">
        <view
          class="chart-point {{selectedTrend && selectedTrend.chart === 'weight' && selectedTrend.index === index ? 'chart-point-selected' : ''}}"
          wx:for="{{weight.points}}"
          wx:key="dateKey"
          data-chart="weight"
          data-title="体重趋势"
          data-unit="kg"
          data-index="{{index}}"
          bindtap="selectTrendPoint"
        >
          <view class="bar-track"><view class="trend-bar weight-bar {{item.hasValue ? '' : 'bar-empty'}}" style="height: {{item.height}}rpx;"></view></view>
          <text class="axis-label">{{item.showLabel ? item.label : ''}}</text>
        </view>
      </view>
      <view class="chart-empty" wx:else>当前范围内还没有体重快照</view>
    </view>
  </block>
</view>

.statistics-page {
  padding-bottom: calc(54rpx + env(safe-area-inset-bottom));
}

.statistics-header,
.segmented-control,
.trend-heading,
.loading-chart,
.empty-lines {
  display: flex;
  align-items: center;
}

.statistics-header {
  min-height: 92rpx;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.eyebrow {
  color: #8e8e93;
  font-size: 22rpx;
  font-weight: 600;
}

.statistics-header .page-title {
  margin-top: 4rpx;
  font-size: 46rpx;
}

.segmented-control {
  flex-shrink: 0;
  padding: 4rpx;
  border-radius: 18rpx;
  background: rgba(118, 118, 128, 0.12);
}

.segment {
  width: 90rpx;
  height: 58rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 15rpx;
  background: transparent;
  color: #636366;
  font-size: 23rpx;
  line-height: 58rpx;
  font-weight: 600;
}

.segment::after { border: 0; }

.segment-active,
.segment-active[disabled] {
  background: rgba(255, 255, 255, 0.96);
  color: #1c1c1e;
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.08);
  opacity: 1;
}

.loading-chart {
  height: 140rpx;
  align-items: flex-end;
  gap: 18rpx;
}

.chart-skeleton {
  width: 30rpx;
}

.chart-skeleton.one { height: 60rpx; }
.chart-skeleton.two { height: 120rpx; }
.chart-skeleton.three { height: 86rpx; }

.state-icon {
  display: flex;
  width: 78rpx;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
  border-radius: 50%;
}

.error-icon {
  background: rgba(255, 69, 58, 0.1);
  color: #c9342c;
  font-size: 38rpx;
  font-weight: 800;
}

.empty-lines {
  height: 90rpx;
  align-items: flex-end;
  justify-content: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.empty-lines view {
  width: 18rpx;
  border-radius: 6rpx 6rpx 0 0;
  background: rgba(52, 199, 89, 0.25);
}

.empty-lines view:nth-child(1) { height: 42rpx; }
.empty-lines view:nth-child(2) { height: 78rpx; }
.empty-lines view:nth-child(3) { height: 58rpx; }

.trend-card {
  margin-top: 22rpx;
  padding: 28rpx 26rpx 22rpx;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.04);
}

.trend-heading {
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.trend-meta {
  display: flex;
  min-width: 112rpx;
  flex-shrink: 0;
  justify-content: flex-end;
}

.trend-title,
.trend-subtitle {
  display: block;
}

.trend-title {
  color: #1c1c1e;
  font-size: 28rpx;
  font-weight: 800;
}

.trend-subtitle,
.unit {
  margin-top: 4rpx;
  color: #8e8e93;
  font-size: 20rpx;
}

.unit {
  flex-shrink: 0;
  margin-top: 0;
}

.selected-trend-value {
  display: flex;
  min-height: 52rpx;
  align-items: center;
  gap: 8rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(52, 199, 89, 0.12);
  color: #1c1c1e;
  font-size: 22rpx;
  font-weight: 800;
  white-space: nowrap;
}

.selected-trend-date {
  color: #636366;
  font-size: 19rpx;
  font-weight: 700;
}

.chart {
  display: flex;
  width: 100%;
  height: 230rpx;
  align-items: stretch;
  gap: 3rpx;
  overflow: hidden;
}

.chart-point {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  border-radius: 14rpx;
  transition: background 160ms ease;
}

.chart-point-selected {
  background: rgba(52, 199, 89, 0.08);
}

.bar-track {
  display: flex;
  width: 100%;
  height: 184rpx;
  align-items: flex-end;
  justify-content: center;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}

.trend-bar {
  width: 62%;
  max-width: 30rpx;
  min-height: 4rpx;
  border-radius: 6rpx 6rpx 0 0;
  transition: transform 160ms ease, opacity 160ms ease;
}

.chart-point-selected .trend-bar {
  opacity: 0.92;
  transform: scaleX(1.18);
}

.intake-bar { background: #1c1c1e; }
.exercise-bar { background: #34c759; }
.deficit-positive { background: #34c759; }
.deficit-negative { background: #ff453a; }
.net-positive { background: #ff9f0a; }
.net-negative { background: #ff453a; }
.weight-bar { background: #0a84ff; }
.bar-empty { background: rgba(118, 118, 128, 0.12); }

.axis-label {
  width: 100%;
  height: 34rpx;
  margin-top: 8rpx;
  overflow: hidden;
  color: #8e8e93;
  font-size: 17rpx;
  text-align: center;
  white-space: nowrap;
}

.chart-empty {
  padding: 72rpx 0;
  color: #8e8e93;
  font-size: 24rpx;
  text-align: center;
}

@media (max-width: 340px) {
  .statistics-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .chart {
    gap: 2rpx;
  }
}

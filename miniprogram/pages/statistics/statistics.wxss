.statistics-page {
  --stats-bg: #f7f8f5;
  --surface: rgba(255, 255, 255, 0.92);
  --surface-soft: rgba(242, 242, 247, 0.72);
  --border: rgba(60, 60, 67, 0.1);
  --text-primary: #1c1c1e;
  --text-secondary: #636366;
  --text-tertiary: #8e8e93;
  --green: #34c759;
  --green-strong: #248a3d;
  --blue: #0a84ff;
  --red: #ff453a;
  min-height: 100vh;
  padding: calc(32rpx + env(safe-area-inset-top)) 32rpx calc(54rpx + env(safe-area-inset-bottom));
  background: var(--stats-bg);
  box-sizing: border-box;
  animation: page-fade-in 250ms ease-out both;
}

.statistics-hero,
.segmented-control,
.trend-heading,
.trend-meta,
.loading-chart,
.empty-chart {
  display: flex;
  align-items: center;
}

.statistics-hero {
  min-height: 142rpx;
  justify-content: space-between;
  gap: 24rpx;
}

.statistics-kicker,
.statistics-title,
.statistics-subtitle,
.trend-label,
.trend-title,
.trend-subtitle {
  display: block;
}

.statistics-kicker,
.statistics-subtitle,
.trend-label,
.trend-subtitle,
.unit,
.axis-label,
.selected-trend-date {
  color: var(--text-tertiary);
  font-size: 23rpx;
  font-weight: 650;
}

.statistics-title {
  margin-top: 4rpx;
  color: var(--text-primary);
  font-size: 66rpx;
  line-height: 1.04;
  font-weight: 900;
}

.statistics-subtitle {
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
}

.segmented-control {
  flex-shrink: 0;
  gap: 4rpx;
  padding: 5rpx;
  border-radius: 24rpx;
  background: rgba(118, 118, 128, 0.12);
}

.segment {
  width: 92rpx;
  height: 56rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 19rpx;
  background: transparent;
  color: var(--text-secondary);
  font-size: 23rpx;
  line-height: 56rpx;
  font-weight: 760;
}

.segment::after {
  border: 0;
}

.segment-active,
.segment-active[disabled] {
  background: rgba(255, 255, 255, 0.96);
  color: var(--text-primary);
  box-shadow: 0 3rpx 10rpx rgba(0, 0, 0, 0.08);
  opacity: 1;
}

.trend-card,
.overview-card,
.state-card {
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 48rpx;
  background: var(--surface);
  box-shadow: 0 12rpx 34rpx rgba(0, 0, 0, 0.045);
  -webkit-backdrop-filter: blur(28rpx);
  backdrop-filter: blur(28rpx);
  box-sizing: border-box;
}

.overview-card {
  margin-top: 16rpx;
  padding: 32rpx 30rpx 28rpx;
}

.overview-heading,
.overview-value-row,
.overview-metric-wide {
  display: flex;
  align-items: center;
}

.overview-heading {
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.overview-title,
.overview-caption,
.overview-label,
.overview-note {
  display: block;
}

.overview-title {
  color: var(--text-primary);
  font-size: 35rpx;
  line-height: 1.2;
  font-weight: 860;
}

.overview-caption,
.overview-label,
.overview-note,
.overview-unit {
  color: var(--text-tertiary);
  font-size: 21rpx;
  line-height: 1.35;
  font-weight: 650;
}

.overview-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.overview-metric {
  min-width: 0;
  min-height: 132rpx;
  padding: 22rpx;
  border-radius: 30rpx;
  background: var(--surface-soft);
  box-sizing: border-box;
}

.overview-value-row {
  min-width: 0;
  align-items: baseline;
  gap: 7rpx;
  margin-top: 13rpx;
}

.overview-value {
  min-width: 0;
  color: var(--text-primary);
  font-size: 38rpx;
  line-height: 1;
  font-weight: 880;
  white-space: nowrap;
}

.overview-value-danger {
  color: var(--red);
}

.overview-unit {
  overflow: hidden;
  font-size: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-metric-wide {
  min-height: 104rpx;
  grid-column: 1 / -1;
  justify-content: space-between;
  gap: 24rpx;
}

.overview-note {
  margin-top: 7rpx;
  font-size: 19rpx;
}

.overview-streak {
  flex-shrink: 0;
  color: var(--green-strong);
}

.card-fade {
  animation: card-rise 260ms ease-out both;
}

.trend-card {
  margin-top: 28rpx;
  padding: 32rpx 30rpx 26rpx;
  overflow: hidden;
}

.primary-trend {
  margin-top: 16rpx;
  padding-top: 36rpx;
}

.trend-heading {
  justify-content: space-between;
  gap: 22rpx;
  margin-bottom: 24rpx;
}

.trend-label {
  margin-bottom: 7rpx;
  color: var(--green-strong);
  font-size: 21rpx;
  font-weight: 820;
}

.trend-title {
  color: var(--text-primary);
  font-size: 35rpx;
  line-height: 1.22;
  font-weight: 860;
}

.trend-subtitle {
  margin-top: 6rpx;
  font-size: 22rpx;
}

.trend-meta {
  min-width: 118rpx;
  flex-shrink: 0;
  justify-content: flex-end;
}

.unit {
  font-size: 22rpx;
  font-weight: 760;
}

.selected-trend-value {
  display: flex;
  min-height: 54rpx;
  align-items: center;
  gap: 9rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(52, 199, 89, 0.12);
  color: var(--text-primary);
  font-size: 23rpx;
  font-weight: 860;
  white-space: nowrap;
}

.selected-trend-date {
  color: var(--text-secondary);
  font-size: 19rpx;
  font-weight: 760;
}

.chart {
  display: flex;
  width: 100%;
  height: 238rpx;
  align-items: stretch;
  gap: 4rpx;
  overflow: hidden;
}

.hero-chart {
  height: 276rpx;
}

.chart-point {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  border-radius: 18rpx;
  transition: background 250ms ease-out;
}

.chart-point-selected {
  background: rgba(52, 199, 89, 0.08);
}

.bar-track {
  display: flex;
  width: 100%;
  height: 192rpx;
  align-items: flex-end;
  justify-content: center;
  border-bottom: 1rpx solid var(--border);
}

.hero-chart .bar-track {
  height: 230rpx;
}

.trend-bar {
  width: 58%;
  max-width: 32rpx;
  min-height: 4rpx;
  border-radius: 999rpx 999rpx 0 0;
  transition: transform 250ms ease-out, opacity 250ms ease-out;
}

.chart-point-selected .trend-bar {
  opacity: 0.94;
  transform: scaleX(1.2);
}

.intake-bar {
  background: #1c1c1e;
}

.exercise-bar,
.deficit-positive {
  background: var(--green);
}

.deficit-negative {
  background: var(--red);
}

.weight-bar {
  background: var(--blue);
}

.bar-empty {
  background: rgba(118, 118, 128, 0.14);
}

.axis-label {
  width: 100%;
  height: 34rpx;
  margin-top: 8rpx;
  overflow: hidden;
  font-size: 17rpx;
  text-align: center;
  white-space: nowrap;
}

.chart-empty {
  padding: 76rpx 0;
  border-radius: 28rpx;
  background: var(--surface-soft);
  color: var(--text-tertiary);
  font-size: 24rpx;
  text-align: center;
}

.state-card {
  display: flex;
  min-height: 430rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  padding: 56rpx 34rpx;
  text-align: center;
}

.loading-chart {
  height: 150rpx;
  align-items: flex-end;
  gap: 18rpx;
}

.chart-skeleton {
  width: 30rpx;
  border-radius: 999rpx 999rpx 0 0;
}

.chart-skeleton.one { height: 60rpx; }
.chart-skeleton.two { height: 128rpx; }
.chart-skeleton.three { height: 88rpx; }

.state-orb {
  display: flex;
  width: 82rpx;
  height: 82rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
  border-radius: 50%;
  font-size: 38rpx;
  font-weight: 850;
}

.error-orb {
  background: rgba(255, 69, 58, 0.1);
  color: #c9342c;
}

.empty-chart {
  height: 96rpx;
  align-items: flex-end;
  justify-content: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.empty-chart view {
  width: 18rpx;
  border-radius: 999rpx 999rpx 0 0;
  background: rgba(52, 199, 89, 0.25);
}

.empty-chart view:nth-child(1) { height: 42rpx; }
.empty-chart view:nth-child(2) { height: 82rpx; }
.empty-chart view:nth-child(3) { height: 58rpx; }

.state-title {
  color: var(--text-primary);
  font-size: 33rpx;
  line-height: 1.35;
  font-weight: 860;
}

.state-copy {
  max-width: 560rpx;
  margin-top: 12rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.55;
}

.state-action {
  min-height: 72rpx;
  margin-top: 28rpx;
  padding: 0 28rpx;
  border: 0;
  border-radius: 22rpx;
  background: rgba(10, 132, 255, 0.12);
  color: var(--blue);
  font-size: 26rpx;
  line-height: 72rpx;
  font-weight: 780;
}

.state-action::after {
  border: 0;
}

.button-press {
  transition: opacity 250ms ease-out, transform 250ms ease-out;
}

.button-press:active {
  opacity: 0.78;
  transform: scale(0.975);
}

@keyframes page-fade-in {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes card-rise {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 340px) {
  .statistics-page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .statistics-hero {
    align-items: flex-start;
    flex-direction: column;
  }

  .chart {
    gap: 2rpx;
  }
}

<view class="page history-page">
  <view class="history-header">
    <view>
      <view class="eyebrow">健康日志</view>
      <view class="page-title">历史记录</view>
    </view>
    <picker mode="date" value="{{selectedDate}}" bindchange="onDateChange">
      <view class="date-picker">{{selectedDate}}</view>
    </picker>
  </view>

  <view class="state-view" wx:if="{{loading}}">
    <view class="loading-stack">
      <view class="skeleton skeleton-title"></view>
      <view class="skeleton skeleton-copy"></view>
    </view>
    <view class="state-copy">正在读取云端记录...</view>
  </view>

  <view class="state-view error-state" wx:elif="{{recordError}}">
    <view class="state-icon error-icon">!</view>
    <view class="state-title">记录暂时无法载入</view>
    <view class="state-copy">{{recordError}}</view>
    <button class="state-action" bindtap="retryRecord">重新加载</button>
  </view>

  <view class="state-view empty-state" wx:elif="{{!hasData}}">
    <view class="state-icon empty-icon">＋</view>
    <view class="state-title">这一天还没有记录</view>
    <view class="state-copy">选择其他日期，或回到今日添加饮食和运动。</view>
  </view>

  <block wx:else>
    <view class="summary-band">
      <view class="summary-item"><text class="summary-label">摄入</text><text class="summary-number">{{record.totalCaloriesIn}}</text><text class="summary-unit">kcal</text></view>
      <view class="summary-item"><text class="summary-label">运动</text><text class="summary-number blue-number">{{record.totalCaloriesOut}}</text><text class="summary-unit">kcal</text></view>
      <view class="summary-item"><text class="summary-label">净摄入</text><text class="summary-number">{{record.netCalories}}</text><text class="summary-unit">kcal</text></view>
      <view class="summary-item"><text class="summary-label">体重</text><text class="summary-number weight-value">{{record.weightText}}</text><text class="summary-unit">快照</text></view>
    </view>

    <view class="section-heading"><text class="section-title">饮食摄入</text><text class="section-count">{{record.foods.length}} 项</text></view>
    <view class="settings-group record-group">
      <view class="item-row" wx:for="{{record.foods}}" wx:key="id">
        <view class="item-copy"><view class="item-name">{{item.name}}</view><view class="muted small">{{item.amountText}}</view></view>
        <view class="item-actions">
          <text class="calorie-in">{{item.caloriesText}}</text>
          <button class="delete-button {{deletingId ? 'delete-button-disabled' : ''}}" loading="{{deletingId === item.id}}" disabled="{{!!deletingId}}" data-item-type="food" data-item-id="{{item.id}}" data-title="{{item.name}}" bindtap="deleteItem">删除</button>
        </view>
      </view>
      <view class="inline-empty" wx:if="{{!record.foods.length}}">没有饮食记录</view>
    </view>

    <view class="section-heading"><text class="section-title">运动消耗</text><text class="section-count">{{record.exercises.length}} 项</text></view>
    <view class="settings-group record-group">
      <view class="item-row" wx:for="{{record.exercises}}" wx:key="id">
        <view class="item-copy"><view class="item-name">{{item.name}}</view><view class="muted small">{{item.durationText}}</view></view>
        <view class="item-actions">
          <text class="calorie-out">{{item.caloriesText}}</text>
          <button class="delete-button {{deletingId ? 'delete-button-disabled' : ''}}" loading="{{deletingId === item.id}}" disabled="{{!!deletingId}}" data-item-type="exercise" data-item-id="{{item.id}}" data-title="{{item.name}}" bindtap="deleteItem">删除</button>
        </view>
      </view>
      <view class="inline-empty" wx:if="{{!record.exercises.length}}">没有运动记录</view>
    </view>
  </block>
</view>

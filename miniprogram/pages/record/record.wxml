<view class="page history-page">
  <view class="history-hero">
    <view>
      <text class="history-kicker">History</text>
      <text class="history-title">历史</text>
      <text class="history-subtitle">按日期回看饮食与运动</text>
    </view>
    <picker mode="date" value="{{selectedDate}}" bindchange="onDateChange">
      <view class="calendar-pill">
        <text class="calendar-month">日期</text>
        <text class="calendar-date">{{selectedDate}}</text>
      </view>
    </picker>
  </view>

  <view class="state-card" wx:if="{{loading}}">
    <view class="loading-stack">
      <view class="skeleton skeleton-title"></view>
      <view class="skeleton skeleton-copy"></view>
    </view>
    <view class="state-copy">正在读取云端记录...</view>
  </view>

  <view class="state-card error-state" wx:elif="{{recordError}}">
    <view class="state-orb error-orb">!</view>
    <view class="state-title">记录暂时无法载入</view>
    <view class="state-copy">{{recordError}}</view>
    <button class="state-action button-press" bindtap="retryRecord">重新加载</button>
  </view>

  <view class="state-card empty-state" wx:elif="{{!hasData}}">
    <view class="state-orb empty-orb"></view>
    <view class="state-title">这一天还没有记录</view>
    <view class="state-copy">选择其他日期，或回到今日添加饮食和运动。</view>
  </view>

  <block wx:else>
    <view class="day-card card-fade">
      <view class="day-card-head">
        <view>
          <text class="day-label">Selected Day</text>
          <text class="day-date">{{record.date}}</text>
        </view>
        <text class="day-chip">Timeline</text>
      </view>

      <view class="deficit-hero">
        <text class="deficit-label">热量缺口</text>
        <view class="deficit-line {{record.deficitTone === 'negative' ? 'red-number' : 'green-number'}}">
          <text class="deficit-number">{{record.calorieDeficit}}</text>
          <text class="deficit-unit">kcal</text>
        </view>
      </view>

      <view class="summary-band">
        <view class="summary-item">
          <text class="summary-number">{{record.totalCaloriesIn}}</text>
          <text class="summary-label">摄入 kcal</text>
        </view>
        <view class="summary-item">
          <text class="summary-number blue-number">{{record.totalCaloriesOut}}</text>
          <text class="summary-label">运动 kcal</text>
        </view>
        <view class="summary-item">
          <text class="summary-number weight-value">{{record.weightText}}</text>
          <text class="summary-label">体重快照</text>
        </view>
      </view>
    </view>

    <view class="timeline-card card-fade">
      <view class="section-heading">
        <view>
          <text class="section-title">饮食摄入</text>
          <text class="section-subtitle">{{record.foods.length}} 项</text>
        </view>
      </view>

      <view class="timeline-list">
        <view class="timeline-row" wx:for="{{record.foods}}" wx:key="id">
          <view class="timeline-rail"><view class="timeline-dot"></view></view>
          <view class="timeline-item">
            <view class="item-thumb">F</view>
            <view class="item-copy">
              <view class="item-name">{{item.name}}</view>
              <view class="item-meta">{{item.amountText}}</view>
            </view>
            <view class="item-actions">
              <text class="calorie-in">{{item.caloriesText}}</text>
              <button class="delete-button button-press {{deletingId ? 'delete-button-disabled' : ''}}" loading="{{deletingId === item.id}}" disabled="{{!!deletingId}}" data-item-type="food" data-item-id="{{item.id}}" data-title="{{item.name}}" bindtap="deleteItem">删除</button>
            </view>
          </view>
        </view>
        <view class="inline-empty" wx:if="{{!record.foods.length}}">没有饮食记录</view>
      </view>
    </view>

    <view class="timeline-card card-fade">
      <view class="section-heading">
        <view>
          <text class="section-title">运动消耗</text>
          <text class="section-subtitle">{{record.exercises.length}} 项</text>
        </view>
      </view>

      <view class="timeline-list">
        <view class="timeline-row" wx:for="{{record.exercises}}" wx:key="id">
          <view class="timeline-rail"><view class="timeline-dot blue-dot"></view></view>
          <view class="timeline-item">
            <view class="item-thumb item-thumb-blue">M</view>
            <view class="item-copy">
              <view class="item-name">{{item.name}}</view>
              <view class="item-meta">{{item.durationText}}</view>
            </view>
            <view class="item-actions">
              <text class="calorie-out">{{item.caloriesText}}</text>
              <button class="delete-button button-press {{deletingId ? 'delete-button-disabled' : ''}}" loading="{{deletingId === item.id}}" disabled="{{!!deletingId}}" data-item-type="exercise" data-item-id="{{item.id}}" data-title="{{item.name}}" bindtap="deleteItem">删除</button>
            </view>
          </view>
        </view>
        <view class="inline-empty" wx:if="{{!record.exercises.length}}">没有运动记录</view>
      </view>
    </view>
  </block>
</view>

.history-page {
  --history-bg: #f7f8f5;
  --surface: rgba(255, 255, 255, 0.92);
  --surface-soft: rgba(242, 242, 247, 0.72);
  --border: rgba(60, 60, 67, 0.1);
  --text-primary: #1c1c1e;
  --text-secondary: #636366;
  --text-tertiary: #8e8e93;
  --green: #34c759;
  --green-strong: #248a3d;
  --blue: #0a84ff;
  --red: #ff453a;
  min-height: 100vh;
  padding: calc(32rpx + env(safe-area-inset-top)) 32rpx calc(54rpx + env(safe-area-inset-bottom));
  background: var(--history-bg);
  box-sizing: border-box;
  animation: page-fade-in 250ms ease-out both;
}

.history-hero,
.day-card-head,
.section-heading,
.summary-band,
.timeline-row,
.timeline-item,
.item-actions {
  display: flex;
  align-items: center;
}

.history-hero {
  min-height: 142rpx;
  justify-content: space-between;
  gap: 26rpx;
}

.history-kicker,
.history-title,
.history-subtitle,
.day-label,
.day-date,
.deficit-label,
.section-title,
.section-subtitle {
  display: block;
}

.history-kicker,
.history-subtitle,
.day-label,
.section-subtitle,
.summary-label,
.item-meta,
.inline-empty {
  color: var(--text-tertiary);
  font-size: 23rpx;
  font-weight: 650;
}

.history-title {
  margin-top: 4rpx;
  color: var(--text-primary);
  font-size: 66rpx;
  line-height: 1.04;
  font-weight: 900;
}

.history-subtitle {
  margin-top: 6rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
}

.calendar-pill {
  display: flex;
  min-width: 206rpx;
  min-height: 74rpx;
  flex-direction: column;
  justify-content: center;
  padding: 10rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 28rpx;
  background: var(--surface);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.045);
  box-sizing: border-box;
}

.calendar-month {
  color: var(--text-tertiary);
  font-size: 19rpx;
  font-weight: 760;
}

.calendar-date {
  margin-top: 3rpx;
  color: var(--text-primary);
  font-size: 24rpx;
  font-weight: 820;
}

.day-card,
.timeline-card,
.state-card {
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 48rpx;
  background: var(--surface);
  box-shadow: 0 12rpx 34rpx rgba(0, 0, 0, 0.045);
  -webkit-backdrop-filter: blur(28rpx);
  backdrop-filter: blur(28rpx);
  box-sizing: border-box;
}

.card-fade {
  animation: card-rise 260ms ease-out both;
}

.day-card {
  margin-top: 16rpx;
  padding: 38rpx 34rpx 32rpx;
}

.day-card-head {
  justify-content: space-between;
  gap: 22rpx;
}

.day-date {
  margin-top: 6rpx;
  color: var(--text-primary);
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 860;
}

.day-chip {
  display: flex;
  height: 48rpx;
  align-items: center;
  justify-content: center;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(52, 199, 89, 0.1);
  color: var(--green-strong);
  font-size: 22rpx;
  font-weight: 820;
}

.deficit-hero {
  margin-top: 34rpx;
}

.deficit-label {
  color: var(--text-tertiary);
  font-size: 23rpx;
  font-weight: 760;
}

.deficit-line {
  display: flex;
  min-width: 0;
  align-items: flex-end;
  gap: 10rpx;
  margin-top: 12rpx;
}

.deficit-number {
  max-width: 430rpx;
  overflow: hidden;
  font-size: 96rpx;
  line-height: 0.92;
  font-weight: 950;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.deficit-unit {
  padding-bottom: 12rpx;
  font-size: 29rpx;
  line-height: 1;
  font-weight: 850;
}

.summary-band {
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 30rpx;
  padding: 20rpx;
  border-radius: 32rpx;
  background: rgba(242, 242, 247, 0.55);
}

.summary-item {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.summary-number {
  max-width: 100%;
  overflow: hidden;
  color: var(--text-primary);
  font-size: 36rpx;
  line-height: 1;
  font-weight: 900;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-label {
  margin-top: 10rpx;
  font-size: 20rpx;
  text-align: center;
}

.weight-value {
  font-size: 29rpx;
}

.blue-number,
.calorie-out {
  color: var(--blue);
}

.green-number {
  color: var(--green-strong);
}

.red-number {
  color: var(--red);
}

.timeline-card {
  margin-top: 28rpx;
  padding: 32rpx;
}

.section-heading {
  justify-content: space-between;
  gap: 22rpx;
}

.section-title {
  color: var(--text-primary);
  font-size: 35rpx;
  line-height: 1.22;
  font-weight: 860;
}

.section-subtitle {
  margin-top: 5rpx;
  font-size: 22rpx;
}

.timeline-list {
  margin-top: 22rpx;
}

.timeline-row {
  align-items: stretch;
  gap: 14rpx;
  min-height: 116rpx;
}

.timeline-rail {
  display: flex;
  width: 28rpx;
  flex-shrink: 0;
  justify-content: center;
  padding-top: 42rpx;
  background: linear-gradient(90deg, transparent 0 12rpx, rgba(60, 60, 67, 0.1) 12rpx 14rpx, transparent 14rpx 100%);
}

.timeline-dot {
  width: 15rpx;
  height: 15rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 0 1rpx rgba(52, 199, 89, 0.18);
  box-sizing: border-box;
}

.blue-dot {
  background: var(--blue);
  box-shadow: 0 0 0 1rpx rgba(10, 132, 255, 0.18);
}

.timeline-item {
  min-width: 0;
  flex: 1;
  min-height: 104rpx;
  gap: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 28rpx;
  background: rgba(247, 247, 249, 0.84);
  box-sizing: border-box;
}

.item-thumb {
  display: flex;
  width: 62rpx;
  height: 62rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: rgba(52, 199, 89, 0.12);
  color: var(--green-strong);
  font-size: 23rpx;
  font-weight: 900;
}

.item-thumb-blue {
  background: rgba(10, 132, 255, 0.12);
  color: var(--blue);
}

.item-copy {
  min-width: 0;
  flex: 1;
}

.item-name {
  overflow: hidden;
  color: var(--text-primary);
  font-size: 28rpx;
  line-height: 1.28;
  font-weight: 780;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-meta {
  margin-top: 5rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-actions {
  flex-shrink: 0;
  gap: 12rpx;
}

.calorie-in,
.calorie-out {
  font-size: 24rpx;
  font-weight: 840;
  white-space: nowrap;
}

.delete-button {
  width: 76rpx;
  height: 50rpx;
  min-height: 50rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 18rpx;
  background: rgba(255, 69, 58, 0.1);
  color: #c9342c;
  font-size: 21rpx;
  line-height: 50rpx;
  font-weight: 760;
}

.delete-button::after {
  border: 0;
}

.delete-button-disabled {
  opacity: 0.52;
}

.button-press {
  transition: opacity 250ms ease-out, transform 250ms ease-out;
}

.button-press:active {
  opacity: 0.78;
  transform: scale(0.975);
}

.inline-empty {
  padding: 38rpx 0 16rpx;
  text-align: center;
}

.state-card {
  display: flex;
  min-height: 430rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-top: 28rpx;
  padding: 56rpx 34rpx;
  text-align: center;
}

.loading-stack {
  width: 300rpx;
}

.skeleton-title {
  height: 34rpx;
}

.skeleton-copy {
  width: 64%;
  height: 22rpx;
  margin: 18rpx auto 0;
}

.state-orb {
  display: flex;
  width: 82rpx;
  height: 82rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
  border-radius: 50%;
  font-size: 38rpx;
  font-weight: 850;
}

.empty-orb {
  border: 2rpx solid rgba(52, 199, 89, 0.22);
  background: radial-gradient(circle, rgba(52, 199, 89, 0.2) 0 17rpx, transparent 18rpx);
}

.error-orb {
  background: rgba(255, 69, 58, 0.1);
  color: #c9342c;
}

.state-title {
  color: var(--text-primary);
  font-size: 33rpx;
  line-height: 1.35;
  font-weight: 860;
}

.state-copy {
  max-width: 560rpx;
  margin-top: 12rpx;
  color: var(--text-secondary);
  font-size: 26rpx;
  line-height: 1.55;
}

.state-action {
  min-height: 72rpx;
  margin-top: 28rpx;
  padding: 0 28rpx;
  border: 0;
  border-radius: 22rpx;
  background: rgba(10, 132, 255, 0.12);
  color: var(--blue);
  font-size: 26rpx;
  line-height: 72rpx;
  font-weight: 780;
}

.state-action::after {
  border: 0;
}

@keyframes page-fade-in {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes card-rise {
  from {
    opacity: 0;
    transform: translateY(18rpx);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 340px) {
  .history-page {
    padding-right: 24rpx;
    padding-left: 24rpx;
  }

  .history-hero {
    align-items: flex-start;
    flex-direction: column;
  }

  .calendar-pill {
    min-width: 240rpx;
  }

  .deficit-number {
    font-size: 76rpx;
  }

  .summary-band {
    grid-template-columns: 1fr;
  }

  .timeline-item {
    align-items: flex-start;
    flex-direction: column;
  }

  .item-actions {
    width: 100%;
    justify-content: space-between;
  }
}

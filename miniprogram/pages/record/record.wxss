.history-page {
  padding-bottom: calc(50rpx + env(safe-area-inset-bottom));
}

.history-header,
.section-heading,
.item-row,
.item-actions {
  display: flex;
  align-items: center;
}

.history-header {
  min-height: 92rpx;
  justify-content: space-between;
  gap: 20rpx;
}

.eyebrow,
.section-count,
.summary-label,
.summary-unit {
  color: #8e8e93;
  font-size: 22rpx;
  font-weight: 600;
}

.history-header .page-title {
  margin-top: 4rpx;
  font-size: 46rpx;
}

.date-picker {
  min-width: 190rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(60, 60, 67, 0.1);
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #1c1c1e;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  box-sizing: border-box;
}

.loading-stack {
  width: 300rpx;
}

.skeleton-title {
  height: 34rpx;
}

.skeleton-copy {
  width: 64%;
  height: 22rpx;
  margin: 18rpx auto 0;
}

.state-icon {
  display: flex;
  width: 78rpx;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 22rpx;
  border-radius: 50%;
  font-size: 38rpx;
  font-weight: 500;
}

.empty-icon {
  background: rgba(52, 199, 89, 0.12);
  color: #248a3d;
}

.error-icon {
  background: rgba(255, 69, 58, 0.1);
  color: #c9342c;
  font-weight: 800;
}

.summary-band {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 8rpx;
  margin-top: 28rpx;
  padding: 28rpx 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.9);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.04);
}

.summary-item {
  display: flex;
  min-width: 0;
  flex-direction: column;
  align-items: center;
}

.summary-number {
  max-width: 100%;
  margin-top: 5rpx;
  overflow: hidden;
  color: #1c1c1e;
  font-size: 32rpx;
  line-height: 1.2;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.blue-number {
  color: #0a84ff;
}

.green-number {
  color: #248a3d;
}

.red-number {
  color: #ff453a;
}

.summary-item .weight-value {
  font-size: 25rpx;
}

.summary-unit {
  margin-top: 4rpx;
  font-size: 18rpx;
}

.section-heading {
  justify-content: space-between;
  margin: 38rpx 10rpx 12rpx;
}

.record-group {
  margin-top: 0;
}

.item-row {
  min-height: 102rpx;
  justify-content: space-between;
  gap: 18rpx;
  border-bottom: 1rpx solid rgba(60, 60, 67, 0.1);
}

.item-row:last-child {
  border-bottom: 0;
}

.item-copy {
  min-width: 0;
  flex: 1;
}

.item-name {
  overflow-wrap: anywhere;
  font-size: 27rpx;
  font-weight: 700;
}

.small {
  margin-top: 4rpx;
  font-size: 22rpx;
}

.item-actions {
  flex-shrink: 0;
  gap: 14rpx;
}

.calorie-in,
.calorie-out {
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
}

.calorie-out { color: #0a84ff; }

.delete-button {
  width: 78rpx;
  height: 52rpx;
  min-height: 52rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 15rpx;
  background: rgba(255, 69, 58, 0.1);
  color: #c9342c;
  font-size: 21rpx;
  line-height: 52rpx;
}

.delete-button::after { border: 0; }
.delete-button-disabled { opacity: 0.52; }

.inline-empty {
  padding: 34rpx 0;
  color: #8e8e93;
  font-size: 24rpx;
  text-align: center;
}

@media (max-width: 340px) {
  .history-header {
    align-items: flex-start;
    flex-direction: column;
  }

  .date-picker {
    min-width: 220rpx;
  }

  .summary-number {
    font-size: 28rpx;
  }
}

.nutrition-chat-page {
  display: flex;
  min-height: 100vh;
  flex-direction: column;
  padding: calc(32rpx + env(safe-area-inset-top)) 32rpx calc(42rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f7f8f5;
}

.chat-header,
.chat-empty,
.chat-state,
.chat-bubble {
  display: flex;
  flex-direction: column;
}

.chat-kicker {
  color: #8e8e93;
  font-size: 22rpx;
  font-weight: 760;
}

.chat-title {
  margin-top: 10rpx;
  color: #1c1c1e;
  font-size: 52rpx;
  line-height: 1.2;
  font-weight: 900;
}

.chat-subtitle {
  margin-top: 10rpx;
  color: #636366;
  font-size: 26rpx;
  line-height: 1.45;
  font-weight: 650;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 30rpx;
  padding: 2rpx 0 24rpx;
  box-sizing: border-box;
}

.chat-empty,
.chat-state {
  justify-content: center;
  min-height: 260rpx;
  padding: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-radius: 48rpx;
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.92);
  color: #636366;
  font-size: 27rpx;
  line-height: 1.5;
  font-weight: 650;
}

.chat-empty-title {
  color: #1c1c1e;
  font-size: 34rpx;
  font-weight: 850;
}

.chat-empty-copy { margin-top: 14rpx; }

.chat-row {
  display: flex;
  margin-bottom: 20rpx;
}

.chat-row-user { justify-content: flex-end; }
.chat-row-assistant { justify-content: flex-start; }

.chat-bubble {
  max-width: 84%;
  padding: 22rpx 24rpx;
  border-radius: 30rpx;
  color: #1c1c1e;
  font-size: 28rpx;
  line-height: 1.55;
  font-weight: 650;
}

.chat-bubble-user {
  border-bottom-right-radius: 10rpx;
  background: #1c1c1e;
  color: #ffffff;
}

.chat-bubble-assistant {
  border: 1rpx solid rgba(255, 255, 255, 0.78);
  border-bottom-left-radius: 10rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.035);
}

.chat-error {
  margin: 8rpx 4rpx 14rpx;
  color: #ff453a;
  font-size: 23rpx;
  line-height: 1.4;
  font-weight: 650;
}

.chat-composer {
  display: flex;
  align-items: flex-end;
  gap: 14rpx;
  padding: 14rpx 14rpx 14rpx 22rpx;
  border: 1rpx solid rgba(60, 60, 67, 0.1);
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.94);
  box-shadow: 0 10rpx 28rpx rgba(0, 0, 0, 0.06);
}

.chat-input {
  flex: 1;
  min-height: 46rpx;
  max-height: 170rpx;
  padding: 10rpx 0;
  color: #1c1c1e;
  font-size: 27rpx;
  line-height: 1.45;
}

.chat-send {
  width: 108rpx;
  height: 64rpx;
  margin: 0;
  border: 0;
  border-radius: 999rpx;
  background: #1c1c1e;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 64rpx;
}

.chat-send[disabled] { opacity: 0.42; }
